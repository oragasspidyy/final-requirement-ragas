rules_version = '2';

// PetCareHub Firestore security rules.
// Paste into Firebase Console → Firestore Database → Rules → Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }

    // Each user can only read/write their own profile and sub-collections
    // (pets, vaccinations, appointments, notifications).
    match /users/{uid} {
      allow read, write: if isOwner(uid);

      match /{subcollection}/{docId} {
        allow read, write: if isOwner(uid);
      }
    }

    // Shared list of taken time slots per service per day.
    // Contains only slot times (no personal data), so any signed-in user
    // may read it and update the "slots" list when booking/cancelling.
    match /bookedSlots/{slotDocId} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.resource.data.keys().hasOnly(['slots'])
        && request.resource.data.slots is list
        && request.resource.data.slots.size() <= 20;
      allow delete: if false;
    }
  }
}
